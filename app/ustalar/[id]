"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { useParams } from "next/navigation";
import {
  Star,
  MapPin,
  Phone,
  Clock,
  CheckCircle,
  ArrowLeft,
  MessageSquare,
  Wrench,
  Crown
} from "@/components/Icons";
import { CRAFTSMEN, CATEGORIES } from "@/lib/data";
import { TRANSLATIONS, Language } from "@/lib/translations";

export default function UstaProfilePage() {
  const params = useParams();
  const id = params?.id as string;

  const [craftsman, setCraftsman] = useState<any>(null);
  const [lang, setLang] = useState<Language>("az");
  const [imgError, setImgError] = useState(false);

  const [reviews, setReviews] = useState<any[]>([]);
  const [rating, setRating] = useState(4.9);
  const [newAuthor, setNewAuthor] = useState("");
  const [newRating, setNewRating] = useState(5);
  const [newComment, setNewComment] = useState("");
  const [reviewSuccess, setReviewSuccess] = useState(false);

  useEffect(() => {
    try {
      const savedLang = localStorage.getItem("app_lang") as Language;
      if (savedLang && ["az", "ru", "en"].includes(savedLang)) {
        setLang(savedLang);
      }
    } catch {}

    const handleLangChange = (e: any) => {
      if (e.detail) setLang(e.detail);
    };

    window.addEventListener("langChange", handleLangChange);
    return () => window.removeEventListener("langChange", handleLangChange);
  }, []);

  const t = TRANSLATIONS[lang] || TRANSLATIONS.az;

  useEffect(() => {
    if (!id) return;

    let found: any = null;

    found = CRAFTSMEN.find((c) => String(c.id) === String(id));

    if (!found) {
      try {
        const custom = localStorage.getItem("custom_ustalar");
        if (custom) {
          const list = JSON.parse(custom);
          found = list.find((c: any) => String(c.id) === String(id));
        }
      } catch {}
    }

    if (!found) {
      try {
        const cur = localStorage.getItem("current_user");
        if (cur) {
          const user = JSON.parse(cur);
          if (user && user.role === "usta" && (String(user.id) === String(id) || String(user.phone) === String(id))) {
            found = user;
          }
        }
      } catch {}
    }

    if (!found && CRAFTSMEN.length > 0) {
      found = CRAFTSMEN[0];
    }

    if (found) {
      setCraftsman(found);
      const initRev = found.reviews || [
        { id: "r1", author: "Nigar Əliyeva", rating: 5, comment: "Çox peşəkar və vaxtında gələn ustadır. İşi keyfiyyətlə gördü.", date: "2025-01-14" },
      ];
      setReviews(initRev);
      setRating(found.rating || 4.9);

      try {
        const savedRev = localStorage.getItem(`usta_reviews_${found.id}`);
        if (savedRev) {
          const parsed = JSON.parse(savedRev);
          if (Array.isArray(parsed) && parsed.length > 0) {
            const combined = [...parsed, ...initRev];
            setReviews(combined);
            const total = combined.reduce((acc: number, r: any) => acc + (r.rating || 5), 0);
            setRating(Number((total / combined.length).toFixed(1)));
          }
        }
      } catch {}
    }
  }, [id]);

  if (!craftsman) {
    return (
      <div className="bg-[#0b1120] min-h-screen text-white flex items-center justify-center p-6">
        <div className="text-center space-y-4">
          <div className="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
          <p className="font-bold text-sm text-slate-400">Usta məlumatları yüklənir...</p>
        </div>
      </div>
    );
  }

  const category = CATEGORIES.find((c) => c.slug === craftsman.categorySlug || c.name === craftsman.category);
  const relatedCraftsmen = CRAFTSMEN.filter(
    (c) => (c.categorySlug === craftsman.categorySlug || c.category === craftsman.category) && String(c.id) !== String(craftsman.id)
  ).slice(0, 3);

  const rawPhone = craftsman.phone || "+994501234567";
  const cleanPhone = rawPhone.replace(/[^0-9+]/g, "");
  const whatsappNum = craftsman.whatsapp || cleanPhone.replace("+", "");
  const whatsappUrl = `https://wa.me/${whatsappNum}?text=${encodeURIComponent(
    `Salam ${craftsman.name}! Sizi UstaAz saytında gördüm. Xidmətinizlə bağlı əlaqə saxlamaq istəyirəm.`
  )}`;

  const expYears = craftsman.experienceYears || craftsman.experience || 8;
  const ustaStatus = craftsman.status || "active";
  const avatarUrl = craftsman.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(craftsman.name)}&background=2563EB&color=fff&size=200`;

  const handleAddReview = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newAuthor.trim() || !newComment.trim()) return;

    const newRev = {
      id: "rev_" + Date.now(),
      author: newAuthor.trim(),
      rating: newRating,
      comment: newComment.trim(),
      date: new Date().toISOString().split("T")[0],
    };

    const updated = [newRev, ...reviews];
    setReviews(updated);
    const total = updated.reduce((acc, r) => acc + r.rating, 0);
    setRating(Number((total / updated.length).toFixed(1)));

    try {
      const existingSaved = localStorage.getItem(`usta_reviews_${craftsman.id}`);
      const list = existingSaved ? JSON.parse(existingSaved) : [];
      localStorage.setItem(`usta_reviews_${craftsman.id}`, JSON.stringify([newRev, ...list]));
    } catch {}

    setNewAuthor("");
    setNewComment("");
    setNewRating(5);
    setReviewSuccess(true);
    setTimeout(() => setReviewSuccess(false), 3500);
  };

  return (
    <div className="bg-[#0b1120] text-white min-h-screen py-8 px-4 transition-colors">
      <div className="max-w-6xl mx-auto space-y-6">
        <div>
          <Link
            href="/ustalar"
            className="inline-flex items-center gap-2 text-slate-400 hover:text-white font-bold text-xs bg-[#121c2e] px-4 py-2 rounded-xl border border-slate-800 transition"
          >
            <ArrowLeft className="w-4 h-4" />
            <span>{t.back_btn}</span>
          </Link>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div className="lg:col-span-2 space-y-6">
            <div className="bg-[#121c2e] rounded-3xl border border-slate-800 p-6 sm:p-8 shadow-xl relative overflow-hidden">
              {craftsman.isVip && (
                <div className="absolute top-4 right-4 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-black text-xs px-3 py-1 rounded-full shadow-lg flex items-center gap-1">
                  <span>👑</span> VIP Usta
                </div>
              )}

              <div className="flex flex-col sm:flex-row gap-5 items-start">
                <div className="relative flex-shrink-0">
                  {!imgError ? (
                    <img
                      src={avatarUrl}
                      alt={craftsman.name}
                      onError={() => setImgError(true)}
                      className="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl object-cover border-2 border-slate-700 bg-slate-800 shadow-md"
                    />
                  ) : (
                    <div className="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-blue-600 text-white font-black text-3xl flex items-center justify-center border-2 border-slate-700 shadow-md">
                      {craftsman.name ? craftsman.name.charAt(0) : "U"}
                    </div>
                  )}
                  {craftsman.verified !== false && (
                    <div className="absolute -bottom-1 -right-1 bg-blue-600 rounded-full p-1 border-2 border-[#121c2e]">
                      <CheckCircle className="w-4 h-4 text-white fill-white" />
                    </div>
                  )}
                </div>

                <div className="flex-1 min-w-0">
                  <div className="flex flex-wrap items-center gap-2 mb-1">
                    <h1 className="text-2xl sm:text-3xl font-black text-white">{craftsman.name}</h1>
                    {craftsman.verified !== false && (
                      <span className="bg-blue-500/20 text-blue-400 border border-blue-500/30 text-[11px] font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1">
                        ✓ {t.verified_badge}
                      </span>
                    )}
                  </div>

                  <p className="text-amber-400 font-bold text-sm sm:text-base">
                    {category?.icon} {craftsman.category}
                  </p>

                  <div className="flex items-center gap-4 mt-3 flex-wrap text-xs text-slate-400">
                    <div className="flex items-center gap-1.5">
                      <MapPin className="w-4 h-4 text-slate-500" />
                      <span>{craftsman.district || craftsman.city}</span>
                    </div>
                    <div className="flex items-center gap-1.5">
                      <Clock className="w-4 h-4 text-slate-500" />
                      <span>{expYears} {t.exp_years}</span>
                    </div>
                  </div>

                  {/* 3 Göstərici: Reytinq, Rəylər, Status (QİYMƏT YOXDUR) */}
                  <div className="mt-5 pt-4 border-t border-slate-800 grid grid-cols-3 gap-2 text-center bg-[#1a263d] p-3 rounded-2xl">
                    <div>
                      <div className="text-[11px] text-slate-400 uppercase font-medium">{t.rating_col}</div>
                      <div className="text-sm font-black text-amber-400 mt-0.5">★ {rating}</div>
                    </div>
                    <div className="border-x border-slate-800 px-1">
                      <div className="text-[11px] text-slate-400 uppercase font-medium">{t.reviews_btn}</div>
                      <div className="text-sm font-black text-white mt-0.5">{reviews.length} {t.reviews_count}</div>
                    </div>
                    <div>
                      <div className="text-[11px] text-slate-400 uppercase font-medium">{t.status_label}</div>
                      <div className="text-xs font-black mt-1">
                        {ustaStatus === "busy" ? (
                          <span className="text-amber-400 flex items-center justify-center gap-1">
                            <span className="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                            {t.status_busy}
                          </span>
                        ) : (
                          <span className="text-emerald-400 flex items-center justify-center gap-1">
                            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            {t.status_active}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div className="bg-[#121c2e] rounded-3xl border border-slate-800 p-6 shadow-xl space-y-4">
              <h2 className="text-lg font-black text-white flex items-center gap-2">
                <Wrench className="w-5 h-5 text-amber-400" />
                <span>{t.about_title}</span>
              </h2>
              <p className="text-sm text-slate-300 leading-relaxed">
                {craftsman.description || "Peşəkar usta xidmətləri. Bütün növ təmir və quraşdırma işləri zəmanətlə yerinə yetirilir."}
              </p>

              {craftsman.skills && craftsman.skills.length > 0 && (
                <div className="pt-3 border-t border-slate-800">
                  <h3 className="font-bold text-xs uppercase tracking-wider text-slate-400 mb-3">
                    {t.skills_title}
                  </h3>
                  <div className="flex flex-wrap gap-2">
                    {craftsman.skills.map((skill: string, index: number) => (
                      <span
                        key={index}
                        className="bg-[#1a263d] text-amber-400 border border-slate-700 text-xs font-semibold px-3 py-1.5 rounded-xl"
                      >
                        ✓ {skill}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div className="bg-[#121c2e] rounded-3xl border border-slate-800 p-6 shadow-xl space-y-5">
              <div className="flex items-center justify-between">
                <h2 className="text-lg font-black text-white flex items-center gap-2">
                  <MessageSquare className="w-5 h-5 text-blue-500" />
                  <span>{t.reviews_title} ({reviews.length})</span>
                </h2>
                <span className="text-amber-400 font-bold text-sm">★ {rating} / 5</span>
              </div>

              {reviewSuccess && (
                <div className="p-3.5 bg-emerald-500/20 text-emerald-300 text-xs rounded-2xl border border-emerald-500/40">
                  ✓ Təşəkkür edirik! Rəyiniz qeydə alındı.
                </div>
              )}

              <form onSubmit={handleAddReview} className="bg-[#1a263d] p-4 rounded-2xl border border-slate-700/60 space-y-3">
                <div className="flex gap-2">
                  <input
                    type="text"
                    required
                    placeholder={`${t.your_name} *`}
                    value={newAuthor}
                    onChange={(e) => setNewAuthor(e.target.value)}
                    className="flex-1 bg-[#121c2e] border border-slate-700 rounded-xl p-2.5 text-xs text-white outline-none focus:border-blue-500"
                  />
                  <div className="flex items-center gap-1 bg-[#121c2e] border border-slate-700 rounded-xl px-2.5">
                    {[1, 2, 3, 4, 5].map((val) => (
                      <button
                        key={val}
                        type="button"
                        onClick={() => setNewRating(val)}
                        className={`text-base ${val <= newRating ? "text-amber-400" : "text-slate-600"}`}
                      >
                        ★
                      </button>
                    ))}
                  </div>
                </div>
                <textarea
                  required
                  rows={2}
                  placeholder={`${t.your_review} *`}
                  value={newComment}
                  onChange={(e) => setNewComment(e.target.value)}
                  className="w-full bg-[#121c2e] border border-slate-700 rounded-xl p-2.5 text-xs text-white outline-none focus:border-blue-500"
                ></textarea>
                <button
                  type="submit"
                  className="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl transition shadow"
                >
                  {t.leave_review}
                </button>
              </form>

              <div className="space-y-3 pt-2">
                {reviews.map((r: any, idx: number) => (
                  <div key={idx} className="bg-[#1a263d]/60 p-3.5 rounded-2xl border border-slate-800 text-xs space-y-1">
                    <div className="flex justify-between items-center">
                      <span className="font-bold text-white">{r.author}</span>
                      <span className="text-amber-400">{"★".repeat(r.rating || 5)}</span>
                    </div>
                    <p className="text-slate-300 leading-relaxed">{r.comment}</p>
                    {r.date && <p className="text-[10px] text-slate-500 pt-1">{r.date}</p>}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div className="space-y-6">
            <div className="bg-[#121c2e] rounded-3xl border border-slate-800 p-6 shadow-xl sticky top-24 space-y-4">
              <h3 className="text-lg font-black text-white">{t.contact_title}</h3>

              <a
                href={`tel:${cleanPhone}`}
                className="w-full py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-black text-xs rounded-2xl transition flex items-center justify-center gap-2 shadow-lg"
              >
                <Phone className="w-4 h-4" />
                <span>{craftsman.phone}</span>
              </a>

              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs rounded-2xl transition flex items-center justify-center gap-2 shadow-lg"
              >
                <MessageSquare className="w-4 h-4" />
                <span>WhatsApp ilə Yazın</span>
              </a>

              <div className="pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-2">
                <div className="flex items-center justify-between">
                  <span>Xidmət növü:</span>
                  <strong className="text-white">{craftsman.category}</strong>
                </div>
                <div className="flex items-center justify-between">
                  <span>Ərazi:</span>
                  <strong className="text-white">{craftsman.district || craftsman.city}</strong>
                </div>
                <div className="flex items-center justify-between">
                  <span>Zəmanət:</span>
                  <strong className="text-emerald-400">Rəsmi və Etibarlı</strong>
                </div>
              </div>
            </div>

            {relatedCraftsmen.length > 0 && (
              <div className="bg-[#121c2e] rounded-3xl border border-slate-800 p-6 shadow-xl space-y-4">
                <h3 className="font-bold text-sm text-white">{t.related_ustas}</h3>
                <div className="space-y-3">
                  {relatedCraftsmen.map((c) => (
                    <Link
                      key={c.id}
                      href={`/ustalar/${c.id}`}
                      className="flex items-center gap-3 p-2.5 rounded-2xl hover:bg-[#1a263d] transition group border border-transparent hover:border-slate-800"
                    >
                      <img
                        src={c.avatar}
                        alt={c.name}
                        className="w-11 h-11 rounded-xl object-cover bg-slate-800 border border-slate-700 flex-shrink-0"
                      />
                      <div className="flex-1 min-w-0">
                        <p className="font-bold text-white text-xs truncate group-hover:text-amber-400 transition">
                          {c.name}
                        </p>
                        <p className="text-[11px] text-slate-400 truncate">
                          ⭐ {c.rating} • {c.district || c.city}
                        </p>
                      </div>
                    </Link>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}